# Server Configuration
PORT=10000
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration
# For local development: SQLite (no config needed)
# For production (Render): PostgreSQL (auto-configured via render.yaml)

# PostgreSQL connection (only needed if running Render locally)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=restaurant_db
